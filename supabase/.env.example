# Gene - Nov, 24, 2026: Edge Function secret template for local Supabase dev and Cloud/Self-Hosted deployments.
# Copy to supabase/.env (gitignored) for local dev, or configure via `supabase secrets set` for Cloud.

# 32-byte hex AES-256 master key (64 hex chars) protecting RSA-2048 & AES-256 taxpayer secrets at rest.
# Generate with: openssl rand -hex 32
EIS_VAULT_MASTER_KEY=<32-byte-hex-master-key>

# Shared bearer secret required by eis-retry-worker (invoked by pg_cron / external scheduler).
# Generate with: openssl rand -hex 24
EIS_CRON_SECRET=<random-cron-bearer-secret>

# Optional static-IP egress proxy URL for live BIR Certification / Production PTT endpoints.
# Leave blank when using MOCK_BIR_SIMULATOR or direct egress from a whitelisted self-hosted VPS.
BIR_EGRESS_PROXY_URL=

# Local development ONLY: set to true when running locally without EIS_VAULT_MASTER_KEY configured.
# MUST be false or unset in production so missing EIS_VAULT_MASTER_KEY fails closed.
EIS_ALLOW_DEV_VAULT_FALLBACK=true
